# 寒霜注入工具本机环境变量模板
#
# 用法：复制为 .env.hanshuang 后改成自己的路径。
#   cp .env.hanshuang.example .env.hanshuang
#
# .env.hanshuang 已被 .gitignore 排除，不会进仓库。
# 一键脚本（start-hanshuang.cmd / pack-portable.cmd）会自动读取它。

# ── 数据根 ──
# 注意：这个变量是「主目录替代品」。程序会在它下面拼 .cc-switch/、.codex/、
# .claude/ 等子目录。所以要指向一个伪主目录，而不是 .cc-switch 本身，
# 否则路径会变成 xxx/.cc-switch/.cc-switch/。
HANSHUANG_HOME=E:\ReverseLabWorkspace\home

# ── Codex 配置根 ──
# 留空则回落到 $HANSHUANG_HOME/.codex
CODEX_HOME=E:\AppData\Codex

# ── Seep 逆向工具 ──
# SEEP_PYTHON 必须指向装过 mcp 包的解释器：pip install "mcp>=1.20,<1.29"
SEEP_PYTHON=E:\Learning\Python\python.exe
SEEP_ROOT=E:\ReverseLabWorkspace\seep-reverse-lab

# ── 缓存位置（不设会落到 %LOCALAPPDATA%）──
electron_config_cache=E:\ReverseLabWorkspace\toolchain\electron-cache
ELECTRON_BUILDER_CACHE=E:\ReverseLabWorkspace\toolchain\electron-builder-cache

# ── 打包资源镜像 ──
# electron-builder 的 nsis / winCodeSign / 7zip 默认从 GitHub release 下，
# 国内基本连不上，必须换镜像。
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
