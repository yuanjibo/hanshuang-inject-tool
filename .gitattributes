# Windows 批处理必须是 CRLF，否则 cmd.exe 解析 goto/label 会出错
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell 脚本统一 CRLF（配合 UTF-8 BOM）
*.ps1 text eol=crlf

# 其余源码统一 LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
